# Shell scripts must stay LF. docker-compose.yml runs every service with
# `command: ["/bin/sh", "scripts/dev.sh", ...]` from the bind mount, so a CRLF
# checkout on Windows makes all ten containers die with `$'\r': not found`.
# start.bat waits on /helse and reports the timeout instead of printing KLAR over
# a dead stack, but the stack is dead either way. Git for Windows sets
# core.autocrlf=true by default, so without this line a Windows clone is broken
# out of the box.
*.sh text eol=lf

# Batch files are the mirror image: cmd.exe needs CRLF.
*.bat text eol=crlf

# CLAUDE.md is a one-line `@AGENTS.md` import that Claude Code expands at session
# start. Git for Windows sets core.autocrlf=true, which would check the file out
# as CRLF and leave a trailing \r on the import path. Pin it to LF so the pointer
# resolves the same on Windows, macOS and Linux.
CLAUDE.md text eol=lf
