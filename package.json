{
  "name": "sok-en-gang",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3210",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "start:vpn": "next start --hostname 0.0.0.0 --port 3210",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "start:reminders": "node --env-file-if-exists=.env.local --import tsx scripts/reminder-worker.mts",
    "diagrams:render": "node scripts/render-diagrams.mjs",
    "sandbox:inspect": "node scripts/inspect-sandbox.mjs",
    "test:ai": "node --env-file=.env.local --import tsx scripts/evaluate-assistant.mts",
    "test:ai:language": "node --env-file=.env.local --import tsx scripts/evaluate-assistant-language.mts",
    "test:ai:flow": "node --env-file=.env.local --import tsx scripts/evaluate-flow.mts",
    "test:eval": "node --import tsx scripts/eval-assistant-goldset.mts",
    "test:eval:live": "ASSISTANT_EVAL_LIVE=1 node --env-file=.env.local --import tsx scripts/eval-assistant-goldset.mts",
    "setup:backend": "node scripts/setup-backend.mjs",
    "test:backend": "backend/.venv/bin/python -m unittest discover -s backend -p \"test_*.py\"",
    "setup:ks": "node scripts/setup-ks.mjs",
    "start:ks": "node scripts/start-ks.mjs"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.21.0",
    "@digdir/designsystemet-react": "^1.21.0",
    "@digdir/designsystemet-theme": "^1.11.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@oslokommune/punkt-assets": "^18.0.0",
    "@oslokommune/punkt-css": "^18.3.2",
    "@oslokommune/punkt-react": "^18.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.3.4",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "sass": "^1.103.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
