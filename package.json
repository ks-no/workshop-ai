    "start:agent": "node apps/process-agent/src/server.js",
    "start:demo": "node apps/demo-gui/src/server.js",
    "start:prosessbygger": "node apps/process-builder/src/server.js",
    "start:matrikkel": "node apps/matrikkel-mock/src/server.js",
    "check:matrikkel-source": "node scripts/check-matrikkel-data-source.js",
    "dev": "echo \"Bruk docker compose up --build for å starte sandboxen\"",
