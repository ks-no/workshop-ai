{
  "name": "innbyggerdialog-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for hackathon-sandbox for moderne innbyggerdialog i kommunal sektor.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "start:backend": "node apps/sandbox-backend/src/server.ts",
    "start:fiks": "node apps/fiks-simulator/src/server.js",
    "start:ai": "node apps/ai-gateway/src/server.js",
    "start:mcp": "node apps/mcp-services/src/server.js",
    "start:brreg-mcp": "node apps/brreg-mcp/src/server.js",
