# Konfigurasjon for sandboxen.
# ./start.sh lager .env automatisk hvis den mangler. Rediger fritt etterpa.
#
# AI_PROVIDER styrer hvor ai-gateway henter svar fra:
#   mock       - maltekst, ingen modell. Raskest, krever ingenting.
#   ollama     - lokal modell.
#   openrouter - skytjeneste, krever API-nokkel.
#   bedrock    - AWS Bedrock, krever IAM-nokler. Se AWS_*/BEDROCK_MODEL_ID under.
#
# Dette er bare startverdien. http://localhost:8082/admin bytter provider (og
# Bedrock-modell) i en kjorende container uten restart, og valget der overstyrer
# denne variabelen til neste bytte.
AI_PROVIDER=ollama

# macOS (Apple Silicon): Ollama kjorer nativt pa verten, tjenestene i Docker.
#   host.docker.internal er ruten fra container til macOS-verten.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Linux/Windows med Ollama i Docker Compose: bruk containernavnet i stedet.
# OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_MODEL=qwen2.5:14b

# Gateoppslag i mcp-services:
#   mock   - bruker kun lokal matrikkel-mock. Fungerer offline.
#   hybrid - prover Geonorge forst, faller tilbake til mock ved nulltreff eller
#            nettfeil. Standard, fordi den taler darlig nett.
#   live   - kun Geonorge. Kaster ved nettfeil, sa hvert gateoppslag blir 500
#            nar du er offline. Velg denne bevisst.
MATRIKKEL_MODE=hybrid
GEONORGE_ADRESSE_API_BASE_URL=https://ws.geonorge.no/adresser/v1

# Timeout for modellkall, i millisekunder. Kallet faller tilbake til maltekst
# nar det gar over.
# AI_TIMEOUT_MS=180000

# Alternativ til lokal modell. Krever nokkel fra https://openrouter.ai
#
# OPENROUTER_MODEL er fritekst og sendes rett videre, sa du kan peke pa en
# sterk modell hvis du har en OpenRouter-nokkel:
#   OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
#   OPENROUTER_MODEL=openai/gpt-4o
# Merk at det ma vare en OpenRouter-nokkel. En Anthropic- eller OpenAI-nokkel
# direkte virker ikke - da ma du legge til en provider i ai-gateway.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# AWS Bedrock. Krever en IAM-rolle med bedrock:InvokeModel begrenset til de
# konkrete inference-profile- og modell-ARN-ene i BEDROCK_MODELS
# (apps/ai-gateway/src/server.js), og en bruker som bare kan sts:AssumeRole inn i
# den rollen (og ideelt en betingelse pa kildeIP i brukerens policy) - ikke bruk
# brede eller administrative nokler her. Se scripts/aws-bedrock-setup.sh og
# scripts/aws-bedrock-add-user.sh.
#
# Nyere Claude-modeller pa Bedrock kan ikke kalles med en ren modell-id -
# InvokeModel avviser det ("bruk en inference profile") - derfor er
# BEDROCK_MODEL_ID en profile-id ("eu.anthropic...."), ikke en bar modell-id.
#
# Modellen kan ogsa velges (og byttes) i /admin uten restart; BEDROCK_MODEL_ID er
# bare startverdien.
#
# Navnet er BEDROCK_AWS_* og ikke bare AWS_* med vilje: skallet ditt har ofte
# allerede AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN satt for dine
# egne (sannsynligvis urelaterte) AWS-nokler, og en variabel som allerede finnes i
# miljoet ditt vinner over denne fila - bade i Docker Compose og i `node --env-file`.
# Kjor scripts/aws-bedrock-assume.sh for a fylle disse ut - skriv dem ikke inn selv.
# BEDROCK_AWS_REGION=eu-north-1
# BEDROCK_AWS_ACCESS_KEY_ID=
# BEDROCK_AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_SESSION_TOKEN=
# BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
