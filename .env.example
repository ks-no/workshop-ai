# Konfigurasjon for sandboxen.
# ./start.sh lager .env automatisk hvis den mangler. Rediger fritt etterpa.
#
# AI_PROVIDER styrer hvor ai-gateway henter svar fra:
#   mock       - maltekst, ingen modell. Raskest, krever ingenting.
#   ollama     - lokal modell.
#   openrouter - skytjeneste, krever API-nokkel.
AI_PROVIDER=ollama

# macOS (Apple Silicon): Ollama kjorer nativt pa verten, tjenestene i Docker.
#   host.docker.internal er ruten fra container til macOS-verten.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Linux/Windows med Ollama i Docker Compose: bruk containernavnet i stedet.
# OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_MODEL=qwen2.5:14b

# Alternativ til lokal modell. Krever nokkel fra https://openrouter.ai
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
