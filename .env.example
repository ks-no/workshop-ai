# Agentic assistant: credentials stay on the local server, never NEXT_PUBLIC_.

# Chooses which model provider backs the assistant: cloudflare or telenor.
AI_PROVIDER=cloudflare

CF_ACCOUNT_ID=
CF_AI_GATEWAY_TOKEN=
LLM_MODEL=workers-ai/@cf/google/gemma-4-26b-a4b-it
CF_AI_GATEWAY_ID=default
ASSISTANT_MODEL_TIMEOUT_MS=90000
ASSISTANT_DATA_DIR=.data
# Optional absolute Python interpreter path; default is the project backend/.venv.
# ASSISTANT_PYTHON=/absolute/path/to/python

# Telenor AI Factory: OpenAI-compatible LiteLLM endpoint behind an API gateway;
# only POST /v1/chat/completions exists.
TELENOR_AI_FACTORY_BASE_URL=
TELENOR_AI_FACTORY_API_KEY=

# Legacy /sfo journey also runs without a language model.
EXPLANATION_MODE=template
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Used only by npm run sandbox:inspect; does not switch the app dataset.
SANDBOX_BASE_URL=http://127.0.0.1:8080

# Model routing by agent role
LLM_COORDINATOR_MODEL=@cf/qwen/qwen3.8-27b
LLM_SPECIALIST_MODEL=@cf/google/gemma-4-26b-a4b-it
# Per-role overrides; fall back to LLM_COORDINATOR_MODEL/LLM_SPECIALIST_MODEL, then LLM_MODEL, when unset.
LLM_TRIAGE_MODEL=
LLM_DRAFT_MODEL=
LLM_CRITIC_MODEL=
LLM_POLISH_MODEL=
# Max critic revision rounds, clamped 1-5; 1 means the loop effectively never revises.
ASSISTANT_MAX_REVISIONS=2

# Official KS workshop sandbox; npm run setup:ks then npm run start:ks.
KS_BACKEND_BASE_URL=http://127.0.0.1:8080
KS_FIKS_BASE_URL=http://127.0.0.1:8081
KS_DIGDIR_BASE_URL=http://127.0.0.1:8086
KS_DIGDIR_ISSUER=http://localhost:8086
KS_PERSON_ID=person-022
# KS_WORKSHOP_DIR=/absolute/path/to/official/workshop-ai

# Front-page step planner (defaults to triage model when unset).
LLM_FLOW_MODEL=
# Private bearer token for the local human review queue API; unset disables operator access.
FLOW_REVIEW_TOKEN=
# Email is an explicit local mock outbox; no SMTP credentials are used.
# Start the durable in-app reminder scheduler with npm run start:reminders.
