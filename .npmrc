# Hoisted puts a real copy of every package in the root node_modules. It is here for
# Windows: pnpm links with NTFS junctions there, and Docker Desktop does not translate
# a junction into the Linux VM, so a linked package is missing inside the container
# even after a successful `pnpm install`. It works by fall-through - the app-local link
# stays, and Node keeps walking up to the real copy in the root.
#
# ai-gateway no longer needs this; nodemon does, so do not remove it as unnecessary.
#
# Two things to know: the whole transitive closure becomes resolvable from every app,
# so an app can import something it never declared and no gate says so. And npm does
# not know this key, so every npm/npx call prints a warning about it.
node-linker=hoisted
