{
  // Sidescriptene her, sammen med den delte felles.ts. Begge må ligge i samme
  // program: felles.ts er et klassisk skript, så requireLogin, withToken og
  // Person er globale og importeres ikke. Uten den i include-listen blir hver
  // bruk en TS2304.
  //
  // Sidescriptene har «export {}» øverst nettopp fordi felles.ts ligger her:
  // uten den ville deres egne krevEl og Tjeneste kollidere med de globale.
  "extends": "../../../../tsconfig.client-base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "../../../shared/client/**/*.ts"]
}
