{
  // Nettleserkoden. Egen fil fordi den trenger stikk motsatt miljø av Node-siden:
  // DOM i stedet for node:*, og ingen @types/node — uten "types": [] ville
  // process og Buffer se ut som om de fantes i en nettleser.
  //
  // Filene serveres som .ts og type-strippes av demo-gui og process-builder ved
  // servering (apps/shared-ui/assets.ts). Derfor gjelder samme regel som på
  // Node-siden: bare syntaks som kan viskes ut, se erasableSyntaxOnly.
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,

    // Sidene er statisk HTML med globale funksjoner, ikke moduler — et bevisst
    // valg, se filhodet i client/felles.ts. Uten "legacy" ville TS regnet hver
    // .ts-fil som en modul (rot-package.json har "type": "module"), og da er
    // felles.ts sine funksjoner usynlige for sidescriptene.
    "moduleDetection": "legacy"
  },
  "include": ["apps/shared-ui/client/**/*.ts", "apps/*/src/client/**/*.ts"],
  "exclude": ["node_modules"]
}
